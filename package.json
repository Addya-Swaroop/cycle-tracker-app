{
  "name": "luna-cycle-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite --host 127.0.0.1",
    "dev:electron": "wait-on http://127.0.0.1:5173 && electron .",
    "build": "vite build",
    "preview": "vite preview",
    "icons": "node scripts/generate-icon.cjs",
    "build:renderer": "vite build",
    "postinstall": "electron-builder install-app-deps",
    "dist:win": "npm run icons && npm run build:renderer && electron-builder --win nsis --x64",
    "pack:win": "npm run icons && npm run build:renderer && electron-builder --win dir --x64"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.88.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  },
  "main": "electron/main.cjs",
  "productName": "Luna",
  "description": "A private, offline-first menstrual cycle tracker.",
  "build": {
    "appId": "com.luna.cycletracker",
    "productName": "Luna",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "npmRebuild": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/luna-icon.ico",
      "artifactName": "Luna-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Luna",
      "uninstallDisplayName": "Luna",
      "deleteAppDataOnUninstall": false
    }
  }
}
